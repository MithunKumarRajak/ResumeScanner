# ResumeScanner environment template

# Backend
APP_NAME="Resume Screener API"
APP_VERSION="2.0.0"
DEBUG=false
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/resume_screener
SECRET_KEY=change-this-secret-key-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ML artifacts
MODEL_DIR=FullStackApp/v6
MODEL_PATH=../model.pkl
TFIDF_PATH=../tfidf.pkl
ENCODER_PATH=../encoder.pkl
RESUME_SCANNER_USE_HF_EMBEDDER=false
RESUME_SCANNER_ENABLE_LLM_FALLBACK=false

# AI fallback providers
GEMINI_API_KEY=
Groq_api_key=

# Email
SENDGRID_API_KEY=
FROM_EMAIL=noreply@resumescanner.com
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# Frontend
# Local Vite dev uses /backend-api so API calls are proxied to FastAPI without CORS/port drift.
VITE_API_URL=/backend-api
