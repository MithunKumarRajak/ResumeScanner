#  App ─
APP_NAME="Resume Screener API"
APP_VERSION="2.0.0"
DEBUG=false

#  Database (PostgreSQL)
# If this is omitted in local development, the API falls back to sqlite:///./resume_screener.db
# so ML-only endpoints such as /predict can still run.
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/resume_screener

#  JWT Auth 
# IMPORTANT: Change this to a long random string in production!
SECRET_KEY=change-this-secret-key-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

#  File Upload ─
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

#  ML Model Paths (relative to backend/ working dir) ─
MODEL_PATH=../model.pkl
TFIDF_PATH=../tfidf.pkl
ENCODER_PATH=../encoder.pkl
MODEL_DIR=FullStackApp/v6
RESUME_SCANNER_USE_HF_EMBEDDER=false
RESUME_SCANNER_ENABLE_LLM_FALLBACK=false

#  Email / Notifications ─
# Option 1: SendGrid (preferred)
SENDGRID_API_KEY=
FROM_EMAIL=noreply@resumescanner.com

# Option 2: SMTP fallback
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

#  AI Providers ─
GEMINI_API_KEY=your-gemini-api-key-here
Groq_api_key=your-groq-api-key-here

#  Docker Compose postgres credentials ─
# These are used by docker-compose.yml when running via Docker.
# If running without Docker, DATABASE_URL above takes precedence.
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=resume_scanner

